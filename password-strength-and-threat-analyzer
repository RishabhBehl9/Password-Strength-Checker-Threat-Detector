import hashlib
import re
import threading
import tkinter as tk
import urllib.error
import urllib.request
from tkinter import ttk

HIBP_URL = "https://api.pwnedpasswords.com/range/"
COMMON = {"password", "123456", "12345678", "123456789", "qwerty", "abc123",
          "letmein", "welcome", "admin", "iloveyou", "monkey", "dragon",
          "football", "login", "passw0rd", "111111", "000000"}
SEQUENCES = ["qwerty", "asdf", "zxcv", "1234", "abcd", "0987"]


def check_strength(pw):
    score, tips = 0, []
    n = len(pw)

    if n >= 16: score += 40
    elif n >= 12: score += 30
    elif n >= 8:
        score += 15
        tips.append("Use at least 12 characters.")
    else:
        tips.append("Too short. Use at least 12 characters.")

    for pattern, name in [(r"[a-z]", "lowercase letters"), (r"[A-Z]", "uppercase letters"),
                          (r"\d", "numbers"), (r"[^A-Za-z0-9]", "special characters")]:
        if re.search(pattern, pw): score += 10
        else: tips.append(f"Add {name}.")

    low = pw.lower()
    if low in COMMON:
        score -= 40
        tips.append("This is a very common password.")
    if re.search(r"(.)\1{2,}", pw):
        score -= 10
        tips.append("Avoid repeating a character 3+ times.")
    if any(s in low for s in SEQUENCES):
        score -= 10
        tips.append("Avoid keyboard/sequential patterns.")
    if re.fullmatch(r"[A-Za-z]+\d{1,4}", pw):
        score -= 5
        tips.append("Avoid the 'word + digits' pattern.")
    if n >= 20: score += 20

    score = max(0, min(100, score))
    label = ("Very Weak" if score < 30 else "Weak" if score < 50 else
             "Moderate" if score < 70 else "Strong" if score < 90 else "Very Strong")
    return score, label, tips


def check_pwned(pw):
    """Returns breach count (0 = not found). Raises RuntimeError on network failure."""
    sha1 = hashlib.sha1(pw.encode("utf-8")).hexdigest().upper()
    prefix, suffix = sha1[:5], sha1[5:]
    req = urllib.request.Request(HIBP_URL + prefix,
                                 headers={"User-Agent": "Password-Checker-GUI", "Add-Padding": "true"})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            body = r.read().decode("utf-8")
    except urllib.error.HTTPError as e:
        raise RuntimeError(f"API error {e.code}")
    except urllib.error.URLError as e:
        raise RuntimeError(f"Network error: {e.reason}")
    for line in body.splitlines():
        h, _, c = line.partition(":")
        if h.strip() == suffix:
            return int(c.strip())
    return 0


def update_strength(*_):
    pw = entry.get()
    if not pw:
        bar["value"] = 0
        strength_lbl.config(text="Strength: -", fg="gray")
        tips_lbl.config(text="")
        return
    score, label, tips = check_strength(pw)
    color = "#d32f2f" if score < 50 else "#f9a825" if score < 70 else "#2e7d32"
    bar["value"] = score
    strength_lbl.config(text=f"Strength: {label} ({score}/100)", fg=color)
    tips_lbl.config(text="\n".join("• " + t for t in tips))


def show_result(count, error):
    check_btn.config(state="normal")
    if error:
        threat_lbl.config(text=f"UNKNOWN - {error}", fg="gray")
    elif count > 0:
        threat_lbl.config(text=f"THREAT DETECTED\nFound {count:,} times in data breaches.\nDo NOT use this password.",
                          fg="#d32f2f")
    else:
        threat_lbl.config(text="SAFE\nNo breach record found.", fg="#2e7d32")


def run_check():
    pw = entry.get()
    if not pw:
        threat_lbl.config(text="Enter a password first.", fg="gray")
        return
    threat_lbl.config(text="Checking breach database...", fg="gray")
    check_btn.config(state="disabled")

    def worker():
        try:
            count, error = check_pwned(pw), None
        except RuntimeError as e:
            count, error = 0, str(e)
        root.after(0, show_result, count, error)

    threading.Thread(target=worker, daemon=True).start()


def toggle_show():
    entry.config(show="" if show_var.get() else "*")


root = tk.Tk()
root.title("Password Strength Checker & Threat Detector")
root.geometry("460x440")
root.resizable(False, False)

tk.Label(root, text="Password Strength & Threat Detector", font=("Segoe UI", 14, "bold")).pack(pady=(15, 5))
tk.Label(root, text="Only a partial hash is sent to the API. Your password stays on your machine.",
         font=("Segoe UI", 8), fg="gray").pack()

entry = tk.Entry(root, show="*", font=("Segoe UI", 12), width=32)
entry.pack(pady=(15, 5))
entry.bind("<KeyRelease>", update_strength)
entry.bind("<Return>", lambda e: run_check())
entry.focus()

show_var = tk.BooleanVar()
tk.Checkbutton(root, text="Show password", variable=show_var, command=toggle_show).pack()

bar = ttk.Progressbar(root, length=320, maximum=100)
bar.pack(pady=(10, 3))
strength_lbl = tk.Label(root, text="Strength: -", font=("Segoe UI", 10, "bold"), fg="gray")
strength_lbl.pack()
tips_lbl = tk.Label(root, text="", font=("Segoe UI", 9), justify="left", fg="#555", wraplength=400)
tips_lbl.pack(pady=3)

check_btn = tk.Button(root, text="Check for Threats", font=("Segoe UI", 11, "bold"),
                      bg="#1565c0", fg="white", padx=12, pady=4, command=run_check)
check_btn.pack(pady=10)

threat_lbl = tk.Label(root, text="", font=("Segoe UI", 11, "bold"), justify="center")
threat_lbl.pack(pady=5)

root.mainloop()
